# ROS 2 Humble runtime for the G1 MuJoCo simulation and the VLN navigation nodes.
# Ubuntu 22.04 / Python 3.10. Works on amd64 and arm64 (Apple silicon via Docker Desktop).
# NaVILA itself still runs in its own CUDA environment (scripts/setup_navila.sh).
FROM ros:humble-ros-base-jammy

ARG TARGETARCH
ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-pip git curl \
        libgl1 libegl1 libgles2 libosmesa6 libgl1-mesa-dri libglfw3 \
        fonts-dejavu-core \
        ros-humble-rmw-cyclonedds-cpp \
        ros-humble-sensor-msgs-py \
        ros-humble-tf2-ros-py \
        ros-humble-rosbag2-storage-mcap \
    && rm -rf /var/lib/apt/lists/*

# CPU torch keeps CUDA out of the simulation image; PyPI aarch64 wheels are CPU-only.
RUN if [ "$TARGETARCH" = "amd64" ]; then \
        python3 -m pip install torch==2.7.1 --index-url https://download.pytorch.org/whl/cpu; \
    else \
        python3 -m pip install torch==2.7.1; \
    fi \
    && python3 -m pip install "mujoco==3.5.0" "numpy==1.26.4" "PyYAML>=6.0,<7" "Pillow>=10,<13" "pytest==8.4.2" \
       "transformers==4.46.3" "sentencepiece==0.2.0" "protobuf>=3.20,<6" \
    && if [ "$TARGETARCH" = "amd64" ]; then python3 -m pip install "usd-core==25.5"; fi

# LiDAR-inertial SLAM for the robot's own map (launch/g1_slam_mapping.launch.py): FAST-LIO2, ROS 2 branch at a
# pinned commit, built against the livox_ros_driver2 message definitions in ros2_ws/ (on the robot the Livox
# driver provides the same messages).
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential python3-colcon-common-extensions python3-dev libeigen3-dev libpcl-dev \
        ros-humble-pcl-ros ros-humble-pcl-conversions \
    && rm -rf /var/lib/apt/lists/*
ARG FAST_LIO_COMMIT=a4743b095409588842a5b30ddfa27e29d2f99164
COPY ros2_ws/src/livox_ros_driver2 /opt/g1_ws/src/livox_ros_driver2
RUN git clone https://github.com/hku-mars/FAST_LIO.git /opt/g1_ws/src/FAST_LIO \
    && cd /opt/g1_ws/src/FAST_LIO && git checkout "$FAST_LIO_COMMIT" && git submodule update --init --recursive \
    && . /opt/ros/humble/setup.sh && cd /opt/g1_ws \
    && colcon build --cmake-args -DCMAKE_BUILD_TYPE=Release && rm -rf build log

# Unitree's G1 SDK stack uses CycloneDDS; keep the same RMW for the simulated graph.
# The repository is mounted at /ws. NVIDIA GPUs: run with --gpus all and
# NVIDIA_DRIVER_CAPABILITIES=all so EGL uses the GPU instead of Mesa llvmpipe.
ENV PYTHONDONTWRITEBYTECODE=1 \
    RMW_IMPLEMENTATION=rmw_cyclonedds_cpp \
    CYCLONEDDS_URI=file:///ws/configs/cyclonedds.xml \
    MUJOCO_GL=egl \
    HF_HOME=/ws/.hf_cache \
    NVIDIA_DRIVER_CAPABILITIES=all \
    PYTHONPATH=/ws

WORKDIR /ws
COPY docker/ros_entrypoint.sh /g1_entrypoint.sh
ENTRYPOINT ["/g1_entrypoint.sh"]
CMD ["bash"]
